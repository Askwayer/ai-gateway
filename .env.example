# Local development uses the TEST database. Real passwords live only in .env.
ADMIN_API_KEY=<generate-with-secrets.token_urlsafe(32)>
# Company candidate is stored separately in local .env.company.
# Selection: default development reads .env; APP_ENV=company selects .env.company.
# APP_ENV_FILE may select another explicit file; never fall back between environments.
DATABASE_URL=postgresql+asyncpg://gateway_test_app:<password>@192.168.2.12:13432/ai_gateway_test
MIGRATION_DATABASE_URL=postgresql+asyncpg://gateway_test_migrator:<password>@192.168.2.12:13432/ai_gateway_test

# Canonical development settings; do not replace these with company values by default.
UPSTREAM_BASE_URL=https://api.deepseek.com
ALLOWED_MODELS=["deepseek-v4-flash"]
INFERENCE_PROBE_MODEL=deepseek-v4-flash
UPSTREAM_HEALTH_PATH=/models
UPSTREAM_STREAM_USAGE_MODE=include_usage
TRUSTED_PROXY_CIDRS=[]
# Set the real value only in local .env; never commit or paste it into reports.
UPSTREAM_API_KEY=
